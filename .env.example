# Environment Configuration for Xosh Chat — Kurdish Xosh Companion App
# Copy this file to .env and supply your local values.
# NEVER commit real credentials, API tokens, or secrets to Git.

# Application hosting URL (injected automatically in production or set for local development)
APP_URL="http://localhost:3000"
PORT=3000

# Optional Gemini API Key for client-safe AI moderation assistance (server-side only)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Roblox Open Cloud API configuration (for production server-to-server linking)
# Obtain from Roblox Creator Hub (Open Cloud API Keys) with explicit place permissions
ROBLOX_API_KEY="YOUR_ROBLOX_OPEN_CLOUD_KEY_HERE"
ROBLOX_UNIVERSE_ID="YOUR_ROBLOX_UNIVERSE_ID_HERE"
ROBLOX_PLACE_ID="YOUR_ROBLOX_PLACE_ID_HERE"

# Session Security & Rate Limiting
SESSION_SECRET="your-temporary-jwt-secret-replace-in-production"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
